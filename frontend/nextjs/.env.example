PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# nếu muốn test catalog & store thì đổi port 8082
NEXT_PUBLIC_API_URL=http://localhost:8082

# Firebase project with Google provider enabled; authorize the customer app domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Frontend-only controls are automatic in development. Production builds default to false.
NEXT_PUBLIC_M3_DEMO_ENABLED=false
