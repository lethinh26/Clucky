stateDiagram-v2
  state Payment {
    [*] --> UNPAID
    UNPAID --> PENDING: bank transfer
    PENDING --> PAID: webhook khớp
    PENDING --> EXPIRED
    PENDING --> MISMATCH
    UNPAID --> COLLECTED: COD
    PAID --> REFUND_PENDING
    REFUND_PENDING --> REFUNDED
  }
  state Shipping {
    [*] --> CREATED
    CREATED --> ASSIGNED: Phase 2
    ASSIGNED --> PICKED_UP: Phase 2
    PICKED_UP --> SHIPPING: Phase 2
    SHIPPING --> DELIVERED: Phase 2
    SHIPPING --> FAILED: Phase 2
  }
